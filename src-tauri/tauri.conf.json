{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CleanGrab",
  "version": "0.2.5",
  "identifier": "com.cleangrab.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CleanGrab",
        "width": 720,
        "height": 760,
        "minWidth": 560,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "create": false
      },
      {
        "label": "toast",
        "title": "CleanGrab Quick Save",
        "width": 380,
        "height": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; media-src 'self' blob: asset: http://asset.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../LICENSE": "LICENSE" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "MagitalStudio",
    "copyright": "Copyright (c) MagitalStudio",
    "shortDescription": "Copy a link. Save it clean.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["English", "French", "Spanish", "PortugueseBR", "Russian", "SimpChinese", "Arabic"]
      }
    }
  }
}
